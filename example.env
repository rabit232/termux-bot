# Copy this file to .env, keep .env private, and fill in your own values.
# Do not commit a populated .env file.

# Matrix connection. Required only when running without --self-test.
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER_ID=@ribit:example.org
MATRIX_PASSWORD=replace-with-a-private-password
MATRIX_DEVICE_ID=RIBIT_TERMUX_02

# Comma-separated full Matrix IDs allowed to use the bot.
RIBIT_AUTHORIZED_USERS=@ribit:example.org

# Model selection: auto tries the loopback server then uses the Ribit 2.0 mock;
# local returns an availability message if the local server is down; mock is offline.
RIBIT_PROVIDER=auto
RIBIT_LOCAL_LLM_URL=http://127.0.0.1:8080/v1
RIBIT_LOCAL_LLM_MODEL=your-local-model-id
RIBIT_LOCAL_LLM_TIMEOUT=30

# Runtime data is intentionally ignored by Git.
RIBIT_RUNTIME_DIR=./runtime

# Disabled by default. Only authorized inviters can be joined when true.
RIBIT_AUTO_JOIN_INVITES=false
